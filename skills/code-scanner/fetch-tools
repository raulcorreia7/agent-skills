#!/usr/bin/env bash
# Install the scanner binaries pinned in tools.txt.
set -euo pipefail

PINS="$(dirname "${BASH_SOURCE[0]}")/tools.txt"
declare -A SHA256 URL
declare -a ALL_TOOLS
WORK=""

usage() {
  cat <<'EOF'
Usage:
  fetch-tools [--dry-run] DEST [TOOL...]

Install the scanner binaries pinned in tools.txt into DEST. Each download must
match its pinned sha256; an existing binary in DEST is replaced. With no TOOL,
install every pinned tool.

Options:
  -n, --dry-run   Print what would be installed; download and write nothing.
  -h, --help      Show help and exit.

Output:  one installed path per line on stdout; errors on stderr.
Exit:    0 success, 1 download or checksum failure, 2 invalid usage.
Needs:   curl, sha256sum, tar.

Examples:
  fetch-tools /tmp/scan-bin
  fetch-tools /tmp/scan-bin gitleaks trivy
  fetch-tools --dry-run /tmp/scan-bin
EOF
}

usage_error() { printf 'fetch-tools: %s\n' "$1" >&2; usage >&2; exit 2; }
fail() { printf 'fetch-tools: %s\n' "$1" >&2; exit 1; }

# tools.txt lines: TOOL SHA256 URL. Blank lines and # comments are skipped.
load_pins() {
  local tool sha256 url
  while read -r tool sha256 url; do
    [[ -z "$tool" || "$tool" == \#* ]] && continue
    SHA256[$tool]=$sha256
    URL[$tool]=$url
    ALL_TOOLS+=("$tool")
  done <"$PINS"
}

# Downloads, verifies, and moves one tool into DEST. A .tar.gz URL is an
# archive that holds the binary under the tool's name.
install_tool() {
  local tool=$1 dest=$2 work=$3
  local download="$work/$tool.download"

  curl -fsSL --proto '=https' -o "$download" "${URL[$tool]}" ||
    fail "download failed: $tool (${URL[$tool]})"
  printf '%s  %s\n' "${SHA256[$tool]}" "$download" | sha256sum -c --status - ||
    fail "checksum mismatch: $tool"

  if [[ "${URL[$tool]}" == *.tar.gz ]]; then
    tar -xzf "$download" -C "$work" "$tool"
  else
    mv "$download" "$work/$tool"
  fi
  chmod 0755 "$work/$tool"
  mv -f "$work/$tool" "$dest/$tool"
  printf '%s\n' "$dest/$tool"
}

main() {
  local dry_run=0
  while (($#)); do
    case "$1" in
      -n | --dry-run) dry_run=1 && shift ;;
      -h | --help) usage && return 0 ;;
      --) shift && break ;;
      -*) usage_error "unknown option: $1" ;;
      *) break ;;
    esac
  done
  (($#)) || usage_error "missing DEST"
  local dest=$1
  shift
  [[ -n "$dest" && "$dest" != "/" ]] || usage_error "DEST must be a directory other than /"

  load_pins
  local -a tools=("$@")
  ((${#tools[@]})) || tools=("${ALL_TOOLS[@]}")
  local tool
  for tool in "${tools[@]}"; do
    [[ -v "SHA256[$tool]" ]] || usage_error "not in tools.txt: $tool"
  done

  if ((dry_run)); then
    for tool in "${tools[@]}"; do
      printf '%s\t%s\n' "$dest/$tool" "${URL[$tool]}"
    done
    return 0
  fi

  mkdir -p -- "$dest"
  # Work inside DEST so the final move is an atomic rename.
  WORK=$(mktemp -d "$dest/.fetch-tools.XXXXXX")
  trap 'rm -rf -- "$WORK"' EXIT
  for tool in "${tools[@]}"; do
    install_tool "$tool" "$dest" "$WORK"
  done
}

main "$@"
