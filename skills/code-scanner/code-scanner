#!/bin/sh
# usage: code-scanner <path> <scanner> [args...]
# Mounts <path> at /src:ro and runs the scanner against it.
# If args already mention /src, they pass through untouched.
# Scanner caches (vulnerability databases, rules) persist in a named volume;
# remove it with `docker volume rm code-scanner-cache`.
set -eu

[ "$#" -ge 2 ] || { echo "usage: code-scanner <path> <scanner> [args...]" >&2; exit 1; }
target=$(realpath "$1")
shift
image=${CODE_SCANNER_IMAGE:-code-scanner:latest}
cache=${CODE_SCANNER_CACHE:-code-scanner-cache}

case "$*" in
  */src*) ;;
  *) set -- "$@" /src ;;
esac
exec docker run --rm -v "$target:/src:ro" -v "$cache:/home/scanner/.cache" "$image" "$@"
