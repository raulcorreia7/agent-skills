{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "to-graph",
  "description": "A workflow graph: nodes keyed by id, linked by `next`. Shape only; `scripts/to_graph.py check` adds the graph checks.",
  "type": "object",
  "required": [
    "version",
    "nodes"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "goal": {
      "$ref": "#/$defs/text"
    },
    "inputs": {
      "description": "Values the graph needs, used as ${NAME} in any string.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "$ref": "#/$defs/text"
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "default": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "criteria": {
      "description": "Acceptance criteria and the nodes that prove them.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "verified_by"
        ],
        "additionalProperties": false,
        "properties": {
          "statement": {
            "$ref": "#/$defs/text"
          },
          "verified_by": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        }
      }
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "outcome": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "names": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "extensions": {
      "type": "object"
    },
    "node": {
      "type": "object",
      "required": [
        "outcome"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "task",
            "gate",
            "terminal"
          ],
          "default": "task"
        },
        "outcome": {
          "description": "What this node achieves.",
          "$ref": "#/$defs/text"
        },
        "done_when": {
          "description": "How you know it is done.",
          "$ref": "#/$defs/text"
        },
        "run": {
          "description": "A shell command, or {uses, with} for any other runner. Without run, the node succeeds when every node that led to it succeeded.",
          "oneOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "object",
              "required": [
                "uses"
              ],
              "additionalProperties": false,
              "properties": {
                "uses": {
                  "$ref": "#/$defs/text"
                },
                "with": {
                  "$ref": "#/$defs/extensions"
                }
              }
            }
          ]
        },
        "outcomes": {
          "description": "Named outcomes beyond succeeded and failed. The run prints one as its last output line.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/outcome"
          }
        },
        "next": {
          "description": "Outcome to next node.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/outcome"
          },
          "additionalProperties": {
            "$ref": "#/$defs/id"
          }
        },
        "retry": {
          "description": "Run again while the outcome is `when`, at most `max` times, then go to `then`.",
          "type": "object",
          "required": [
            "max",
            "when",
            "then"
          ],
          "additionalProperties": false,
          "properties": {
            "max": {
              "type": "integer",
              "minimum": 1
            },
            "when": {
              "$ref": "#/$defs/outcome"
            },
            "then": {
              "$ref": "#/$defs/id"
            },
            "every": {
              "description": "Wait between attempts, such as 30s or 5m.",
              "type": "string",
              "pattern": "^[0-9]+(s|m|h)$"
            }
          }
        },
        "gate": {
          "type": "object",
          "required": [
            "authority"
          ],
          "additionalProperties": false,
          "properties": {
            "authority": {
              "description": "Who decides.",
              "$ref": "#/$defs/text"
            },
            "evidence": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        "status": {
          "enum": [
            "success",
            "failure",
            "blocked"
          ]
        },
        "owner": {
          "$ref": "#/$defs/text"
        },
        "reads": {
          "$ref": "#/$defs/names"
        },
        "writes": {
          "$ref": "#/$defs/names"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "terminal"
              }
            }
          },
          "then": {
            "required": [
              "status"
            ]
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "gate"
              }
            }
          },
          "then": {
            "required": [
              "gate",
              "next"
            ]
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "not": {
                  "required": [
                    "kind"
                  ]
                }
              },
              {
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "task"
                  }
                }
              }
            ]
          },
          "then": {
            "required": [
              "next"
            ]
          }
        }
      ]
    }
  }
}
