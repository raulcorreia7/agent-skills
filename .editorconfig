root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_style = space
indent_size = 4

[*.{toml,yml,yaml}]
indent_style = space
indent_size = 2

[*.{ps1,psm1,psd1}]
indent_size = 4

[*.{cmd,bat}]
end_of_line = crlf
